# Server configuration
PORT=8000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=trip_wheels

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Frontend app URL (used in email and notification links)
APP_BASE_URL=http://localhost:3000

# Authentication tokens
ACCESS_TOKEN_SECRET=replace_with_a_secure_random_string_min_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace_with_another_secure_random_string_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP email service
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Trip Wheels <no-reply@tripwheels.com>"

# Web push (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@tripwheels.com

# Integrations
WHATSAPP_ENABLED=false
JOYTRIPS_BASE_URL=https://joytrips.example.com

