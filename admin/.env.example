# Backend base URL used by Next.js rewrites and server-side fetches (e.g. http://localhost:5000)
BACKEND_URL=

# Public URL of this dashboard (e.g. http://localhost:3001)
NEXT_PUBLIC_APP_URL=

# Public URL of the customer website (e.g. http://localhost:3000)
NEXT_PUBLIC_CUSTOMER_SITE_URL=

# Support email shown in help and suspension messages
NEXT_PUBLIC_SUPPORT_EMAIL=
